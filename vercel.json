{
  "version": 2,
  "builds": [
    {
      "src": "private/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "private/server.js"
    },
    {
      "src": "/check-name",
      "dest": "private/server.js"
    },
    {
      "src": "/deploy",
      "dest": "private/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "private/server.js"
    }
  ]
}
